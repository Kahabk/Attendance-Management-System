APP_NAME=Attendance Management System
SECRET_KEY=change-me
JWT_SECRET=change-me-too
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=Admin@1234!
DEFAULT_ADMIN_EMAIL=admin@example.com
DATABASE_URL=sqlite:///database/attendance.db
RECOGNITION_THRESHOLD=0.45
ATTENDANCE_COOLDOWN_MINUTES=30
WORK_START_TIME=09:15
APP_THEME=dark
ENABLE_STREAMLIT_WEBRTC=true


# CPU-friendly learned face recognition. Download models before first use.
FACE_BACKEND=sface
RECOGNITION_MARGIN=0.08
RECOGNITION_CONFIRMATIONS=3
FACE_DETECTION_CONFIDENCE=0.9
LIVE_RECOGNITION_INTERVAL_MS=250
